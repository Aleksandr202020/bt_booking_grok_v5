# Neon / Vercel automatically provides these.
# For local development, copy values from Vercel project settings
# or from Neon dashboard.

# Pooled connection (app runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Alternative names from Neon Vercel integration (also work):
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
